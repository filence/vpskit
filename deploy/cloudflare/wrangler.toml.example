name = "vpskit-subscriptions-dev"
main = "worker.mjs"
compatibility_date = "2026-07-21"
workers_dev = true

[[kv_namespaces]]
binding = "SUBSCRIPTIONS"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
NODE_ID = "node-main"

# NODE_PUBLISH_SECRET and INITIAL_READ_TOKEN_HASH must be installed as encrypted
# Worker secrets. Never place them in this file or commit a populated copy.
